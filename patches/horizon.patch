diff --git a/crates/horizon-client/src/game/voice.rs b/crates/horizon-client/src/game/voice.rs
new file mode 100644
index 0000000..0f2708c
--- /dev/null
+++ b/crates/horizon-client/src/game/voice.rs
@@ -0,0 +1,63 @@
+//! Opt-in native voice integration, restricted to an explicitly configured game server.
+use super::Game;
+use horizon_client::hud::HudBatch;
+
+#[derive(Default)]
+pub(super) struct VoiceState {
+    #[cfg(feature = "audio")]
+    client: Option<horizon_voice::client::Client>,
+    error: Option<String>,
+}
+impl VoiceState {
+    pub(super) fn join(&mut self, address: &str) {
+        *self = Self::default();
+        if !std::env::var("HORIZON_VOICE_GAME_SERVERS")
+            .unwrap_or_default()
+            .split(',')
+            .any(|s| !s.is_empty() && s == address)
+        {
+            return;
+        }
+        #[cfg(feature = "audio")]
+        match horizon_voice::client::Client::start() {
+            Ok(client) => self.client = Some(client),
+            Err(e) => self.error = Some(e),
+        }
+    }
+    pub(super) fn mute(&self) {
+        #[cfg(feature = "audio")]
+        if let Some(c) = &self.client {
+            c.mute();
+        }
+    }
+    pub(super) fn toggle(&self) {
+        #[cfg(feature = "audio")]
+        if let Some(c) = &self.client {
+            c.toggle();
+        }
+    }
+}
+impl Game<'_> {
+    pub(super) fn tick_voice(&mut self) {
+        #[cfg(feature = "audio")]
+        if let Some(c) = &self.voice.client {
+            let active = self.serving.is_none()
+                && self.title.is_none()
+                && self.remote.as_ref().is_some_and(|r| r.joined);
+            c.set_active(active);
+        }
+    }
+    pub(super) fn draw_voice(&self, batch: &mut HudBatch) {
+        let text = self
+            .voice
+            .error
+            .as_ref()
+            .map(|e| format!("Voice unavailable: {e}"));
+        #[cfg(feature = "audio")]
+        let text = text.or_else(|| self.voice.client.as_ref().map(|c| c.status()));
+        if let Some(text) = text {
+            // Deliberately visible even with F1: an open microphone must never be hidden.
+            batch.text(&self.gui.atlas, &text, 6., 6., u32::MAX, true);
+        }
+    }
+}
