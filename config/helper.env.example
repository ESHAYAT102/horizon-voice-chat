# Private helper configuration, read by horizon-voice-helper at start.
# The installer writes this file as ~/.config/horizon-voice/helper.env (mode 600).
# The environment wins over these values, so a desktop session can override them.
HORIZON_VOICE_SERVER=100.x.y.z:24454
HORIZON_VOICE_KEY=REPLACE_WITH_THE_SHARED_64_CHARACTER_HEX_KEY
# The Horizon game folder: the folder holding options.txt and horizon-mods/.
HORIZON_VOICE_HOME=/home/you/.local/share/horizon
