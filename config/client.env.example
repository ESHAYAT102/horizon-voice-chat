# Private shell file. Copy to ~/.config/horizon-voice/client.env, chmod 600.
# All players use the relay owner's shared 64-character hexadecimal key.
export HORIZON_VOICE_KEY='REPLACE_WITH_SHARED_KEY'
export HORIZON_VOICE_SERVER='100.x.y.z:24454'
# Exact addresses as entered in Horizon's Multiplayer screen, comma-separated.
export HORIZON_VOICE_GAME_SERVERS='100.x.y.z:25566,homelab:25566'
# Keep the same name as your server whitelist (optional; otherwise Horizon generates one).
# export HORIZON_VOICE_PLAYER='YourPlayerName'
# Optional: prepared resources from an existing, compatible Horizon install.
# export HORIZON_VOICE_RESOURCES='/absolute/path/to/versions/TAG/.local/horizon-client/26.3'
