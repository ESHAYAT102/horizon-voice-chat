diff --git i/crates/horizon-client/src/native_voice.rs w/crates/horizon-client/src/native_voice.rs
new file mode 100644
index 00000000..c1171b15
--- /dev/null
+++ w/crates/horizon-client/src/native_voice.rs
@@ -0,0 +1,394 @@
+//! Opt-in voice over the existing game connection. No second socket or room key.
+//! PCM16 mono, 16 kHz, 20 ms frames. TCP means congestion can delay voice.
+pub const CHANNEL: &str = "horizon:voice_v1";
+pub const FRAME: usize = 640;
+pub const HELLO: &[u8] = &[0];
+pub const JOIN: &[u8] = &[1];
+
+/// Local signal indication, not a voice classifier. About -38 dBFS RMS with
+/// a short release prevents flicker between syllables. Silence never lights it.
+#[derive(Default)]
+pub struct SpeechActivity {
+    last: Option<std::time::Instant>,
+}
+impl SpeechActivity {
+    pub fn observe(&mut self, frame: &[u8], now: std::time::Instant) {
+        if frame.len() != FRAME + 1 || frame[0] != 2 {
+            return;
+        }
+        let energy: i64 = frame[1..]
+            .as_chunks::<2>()
+            .0
+            .iter()
+            .map(|b| i64::from(i16::from_le_bytes(*b)).pow(2))
+            .sum();
+        if energy >= (FRAME / 2) as i64 * 400 * 400 {
+            self.last = Some(now);
+        }
+    }
+    pub fn active(&self, now: std::time::Instant) -> bool {
+        self.last.is_some_and(|t| {
+            now.saturating_duration_since(t) < std::time::Duration::from_millis(200)
+        })
+    }
+    pub fn clear(&mut self) {
+        self.last = None;
+    }
+}
+
+/// Original pixel glyph, not an asset copied from another voice mod.
+pub const MIC_PIXELS: [u16; 16] = [
+    0x0000, 0x03c0, 0x07e0, 0x07e0, 0x07e0, 0x07e0, 0x07e0, 0x07e0, 0x1188, 0x1188, 0x0990, 0x07e0,
+    0x0180, 0x0180, 0x07e0, 0x0000,
+];
+
+/// Per-game-connection rate limit; never trust a claimed sender id.
+pub struct Budget {
+    since: std::time::Instant,
+    frames: u32,
+}
+impl Default for Budget {
+    fn default() -> Self {
+        Self {
+            since: std::time::Instant::now(),
+            frames: 0,
+        }
+    }
+}
+impl Budget {
+    pub fn accept(&mut self, bytes: &[u8], now: std::time::Instant) -> bool {
+        if bytes.len() != FRAME + 1 || bytes[0] != 2 {
+            return false;
+        }
+        if now.duration_since(self.since) >= std::time::Duration::from_secs(1) {
+            self.since = now;
+            self.frames = 0;
+        }
+        if self.frames >= 60 {
+            return false;
+        }
+        self.frames += 1;
+        true
+    }
+}
+
+pub fn forwarded(sender: u32, frame: &[u8]) -> Option<Vec<u8>> {
+    if frame.len() != FRAME + 1 || frame[0] != 2 {
+        return None;
+    }
+    let mut data = Vec::with_capacity(FRAME + 5);
+    data.push(2);
+    data.extend_from_slice(&sender.to_be_bytes());
+    data.extend_from_slice(&frame[1..]);
+    Some(data)
+}
+
+#[cfg(feature = "audio")]
+pub mod audio {
+    use super::FRAME;
+    use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};
+    use std::{
+        collections::{HashMap, VecDeque},
+        sync::{
+            Arc, Mutex,
+            atomic::{AtomicBool, Ordering},
+            mpsc::{self, Receiver, SyncSender},
+        },
+        thread,
+        time::Duration,
+    };
+    type Queues = Arc<Mutex<HashMap<u32, VecDeque<f32>>>>;
+    pub struct Audio {
+        muted: Arc<AtomicBool>,
+        alive: Arc<AtomicBool>,
+        outgoing: Receiver<Vec<u8>>,
+        incoming: SyncSender<Vec<u8>>,
+        error: Arc<Mutex<Option<String>>>,
+        activity: Mutex<super::SpeechActivity>,
+    }
+    impl Audio {
+        pub fn start() -> Result<Self, String> {
+            if std::env::var_os("HORIZON_NO_AUDIO").is_some() {
+                return Err("audio disabled".into());
+            }
+            let muted = Arc::new(AtomicBool::new(true));
+            let alive = Arc::new(AtomicBool::new(true));
+            let error = Arc::new(Mutex::new(None));
+            let (tx, outgoing) = mpsc::sync_channel(3);
+            let (incoming, rx) = mpsc::sync_channel(32);
+            let (m, a, e) = (muted.clone(), alive.clone(), error.clone());
+            thread::Builder::new()
+                .name("Native voice audio".into())
+                .spawn(move || {
+                    if let Err(message) = run(tx, rx, m.clone(), a.clone()) {
+                        m.store(true, Ordering::Release);
+                        log::warn!("Native voice audio stopped: {message}");
+                        *e.lock().unwrap() = Some(message);
+                    }
+                    a.store(false, Ordering::Release);
+                })
+                .map_err(|e| e.to_string())?;
+            Ok(Self {
+                muted,
+                alive,
+                outgoing,
+                incoming,
+                error,
+                activity: Mutex::new(super::SpeechActivity::default()),
+            })
+        }
+        pub fn mute(&self) {
+            self.muted.store(true, Ordering::Release);
+            self.activity.lock().unwrap().clear();
+        }
+        pub fn toggle(&self) {
+            if self.alive.load(Ordering::Acquire) && !self.muted.fetch_xor(true, Ordering::AcqRel) {
+                self.activity.lock().unwrap().clear();
+            }
+        }
+        pub fn muted(&self) -> bool {
+            self.muted.load(Ordering::Acquire)
+        }
+        pub fn error(&self) -> Option<String> {
+            self.error.lock().unwrap().clone()
+        }
+        pub fn drain(&self) -> Vec<Vec<u8>> {
+            let frames: Vec<_> = self.outgoing.try_iter().take(3).collect();
+            if self.muted() {
+                self.activity.lock().unwrap().clear();
+                Vec::new()
+            } else {
+                let now = std::time::Instant::now();
+                let mut activity = self.activity.lock().unwrap();
+                for frame in &frames {
+                    activity.observe(frame, now);
+                }
+                frames
+            }
+        }
+        pub fn speaking(&self) -> bool {
+            !self.muted()
+                && self.alive.load(Ordering::Acquire)
+                && self
+                    .activity
+                    .lock()
+                    .unwrap()
+                    .active(std::time::Instant::now())
+        }
+        pub fn receive(&self, bytes: &[u8]) {
+            if bytes.len() == FRAME + 5 && bytes[0] == 2 {
+                let _ = self.incoming.try_send(bytes.to_vec());
+            }
+        }
+    }
+    impl Drop for Audio {
+        fn drop(&mut self) {
+            self.mute();
+            self.alive.store(false, Ordering::Release);
+        }
+    }
+    fn input<T>(
+        device: &cpal::Device,
+        config: &cpal::StreamConfig,
+        tx: SyncSender<Vec<u8>>,
+        muted: Arc<AtomicBool>,
+        alive: Arc<AtomicBool>,
+    ) -> Result<cpal::Stream, String>
+    where
+        T: cpal::SizedSample,
+        f32: cpal::FromSample<T>,
+    {
+        let channels = config.channels as usize;
+        let rate = config.sample_rate.0;
+        let mut phase = 0u32;
+        let mut frame = vec![2u8];
+        let running = alive.clone();
+        device
+            .build_input_stream(
+                config,
+                move |samples: &[T], _| {
+                    if muted.load(Ordering::Acquire) || !running.load(Ordering::Acquire) {
+                        frame.truncate(1);
+                        phase = 0;
+                        return;
+                    }
+                    for chunk in samples.chunks_exact(channels) {
+                        let mono = chunk
+                            .iter()
+                            .map(|s| <f32 as cpal::Sample>::from_sample(*s))
+                            .sum::<f32>()
+                            / channels as f32;
+                        phase += 16000;
+                        while phase >= rate {
+                            phase -= rate;
+                            frame.extend_from_slice(
+                                &((mono.clamp(-1., 1.) * 32767.) as i16).to_le_bytes(),
+                            );
+                            if frame.len() == FRAME + 1 {
+                                let _ = tx.try_send(std::mem::replace(&mut frame, vec![2]));
+                            }
+                        }
+                    }
+                },
+                move |_| {
+                    alive.store(false, Ordering::Release);
+                },
+                None,
+            )
+            .map_err(|e| e.to_string())
+    }
+    fn output<T>(
+        device: &cpal::Device,
+        config: &cpal::StreamConfig,
+        queues: Queues,
+        alive: Arc<AtomicBool>,
+    ) -> Result<cpal::Stream, String>
+    where
+        T: cpal::SizedSample + cpal::FromSample<f32>,
+    {
+        let channels = config.channels as usize;
+        let rate = config.sample_rate.0;
+        let mut phase = 0u32;
+        let mut sample = 0f32;
+        let running = alive.clone();
+        device
+            .build_output_stream(
+                config,
+                move |out: &mut [T], _| {
+                    out.fill(T::from_sample(0.));
+                    if !running.load(Ordering::Acquire) {
+                        return;
+                    }
+                    let Ok(mut queues) = queues.try_lock() else {
+                        return;
+                    };
+                    for chunk in out.chunks_exact_mut(channels) {
+                        phase += 16000;
+                        while phase >= rate {
+                            phase -= rate;
+                            sample = queues
+                                .values_mut()
+                                .map(|q| q.pop_front().unwrap_or(0.))
+                                .sum::<f32>()
+                                .clamp(-1., 1.);
+                        }
+                        chunk.fill(T::from_sample(sample));
+                    }
+                },
+                move |_| {
+                    alive.store(false, Ordering::Release);
+                },
+                None,
+            )
+            .map_err(|e| e.to_string())
+    }
+    fn run(
+        tx: SyncSender<Vec<u8>>,
+        rx: Receiver<Vec<u8>>,
+        muted: Arc<AtomicBool>,
+        alive: Arc<AtomicBool>,
+    ) -> Result<(), String> {
+        let host = cpal::default_host();
+        let mic = host.default_input_device().ok_or("no microphone")?;
+        let speaker = host.default_output_device().ok_or("no audio output")?;
+        let ic = mic.default_input_config().map_err(|e| e.to_string())?;
+        let oc = speaker.default_output_config().map_err(|e| e.to_string())?;
+        let queues: Queues = Arc::new(Mutex::new(HashMap::new()));
+        macro_rules! input {
+            ($t:ty) => {
+                input::<$t>(&mic, &ic.config(), tx, muted.clone(), alive.clone())?
+            };
+        }
+        macro_rules! output {
+            ($t:ty) => {
+                output::<$t>(&speaker, &oc.config(), queues.clone(), alive.clone())?
+            };
+        }
+        let input = match ic.sample_format() {
+            cpal::SampleFormat::F32 => input!(f32),
+            cpal::SampleFormat::I16 => input!(i16),
+            cpal::SampleFormat::U16 => input!(u16),
+            _ => return Err("unsupported microphone format".into()),
+        };
+        let output = match oc.sample_format() {
+            cpal::SampleFormat::F32 => output!(f32),
+            cpal::SampleFormat::I16 => output!(i16),
+            cpal::SampleFormat::U16 => output!(u16),
+            _ => return Err("unsupported speaker format".into()),
+        };
+        input.play().map_err(|e| e.to_string())?;
+        output.play().map_err(|e| e.to_string())?;
+        while alive.load(Ordering::Acquire) {
+            if let Ok(frame) = rx.recv_timeout(Duration::from_millis(20)) {
+                let id = u32::from_be_bytes(frame[1..5].try_into().unwrap());
+                let mut queues = queues.lock().unwrap();
+                queues.retain(|_, q| !q.is_empty());
+                if queues.len() >= 32 && !queues.contains_key(&id) {
+                    continue;
+                }
+                let q = queues.entry(id).or_default();
+                if q.len() + FRAME / 2 > 3200 {
+                    q.clear();
+                }
+                q.extend(
+                    frame[5..]
+                        .as_chunks::<2>()
+                        .0
+                        .iter()
+                        .map(|b| i16::from_le_bytes([b[0], b[1]]) as f32 / 32768.),
+                );
+            }
+        }
+        Err("audio stopped; reconnect to retry".into())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn signal_activity_ignores_silence_and_holds_between_syllables() {
+        let now = std::time::Instant::now();
+        let mut signal = SpeechActivity::default();
+        let frame = |sample: i16| {
+            let mut f = vec![2];
+            for _ in 0..FRAME / 2 {
+                f.extend_from_slice(&sample.to_le_bytes());
+            }
+            f
+        };
+        signal.observe(&frame(0), now);
+        assert!(!signal.active(now));
+        signal.observe(&frame(100), now);
+        assert!(!signal.active(now));
+        signal.observe(&[2, 1], now);
+        assert!(!signal.active(now));
+        signal.observe(&frame(1000), now);
+        assert!(signal.active(now));
+        signal.observe(&frame(0), now + std::time::Duration::from_millis(100));
+        assert!(signal.active(now + std::time::Duration::from_millis(199)));
+        assert!(!signal.active(now + std::time::Duration::from_millis(200)));
+        signal.clear();
+        assert!(!signal.active(now));
+        signal.observe(&frame(i16::MIN), now);
+        assert!(signal.active(now));
+    }
+    #[test]
+    fn identity_and_bounds() {
+        let mut data = vec![2; FRAME + 1];
+        let out = forwarded(42, &data).unwrap();
+        assert_eq!(&out[1..5], &42u32.to_be_bytes());
+        assert_eq!(&out[5..], &data[1..]);
+        data.pop();
+        assert!(forwarded(42, &data).is_none());
+        let mut budget = Budget::default();
+        let now = std::time::Instant::now();
+        assert!(!budget.accept(&data, now));
+        data.push(2);
+        for _ in 0..60 {
+            assert!(budget.accept(&data, now));
+        }
+        assert!(!budget.accept(&data, now));
+        assert!(budget.accept(&data, now + std::time::Duration::from_secs(1)));
+    }
+}
