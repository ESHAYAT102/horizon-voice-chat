diff --git i/crates/horizon-client/src/game/native_voice.rs w/crates/horizon-client/src/game/native_voice.rs
new file mode 100644
index 00000000..7dd44a10
--- /dev/null
+++ w/crates/horizon-client/src/game/native_voice.rs
@@ -0,0 +1,235 @@
+//! Engine extension, not a sandboxed plugin: voice uses joined game sessions.
+use super::{Game, lan::LanHost};
+use horizon_client::native_voice::{self as wire, Budget};
+#[cfg(feature = "audio")]
+use horizon_protocol::packets::play::Serverbound as S;
+use horizon_protocol::packets::{configuration::CustomPayload, play::Clientbound as C};
+use std::collections::HashMap;
+
+#[derive(Default)]
+pub(super) struct NativeVoice {
+    peers: HashMap<u32, Budget>,
+    #[cfg(feature = "audio")]
+    audio: Option<wire::audio::Audio>,
+    #[cfg(feature = "audio")]
+    icons: Option<[Vec<u8>; 3]>,
+}
+/// User-supplied assets stay outside the binary and the public patch.
+#[cfg(feature = "audio")]
+fn load_voice_icons() -> Option<[Vec<u8>; 3]> {
+    let root = Game::options_path().with_file_name("horizon-voice-icons");
+    let mut icons = Vec::new();
+    for name in ["microphone", "microphone_off", "disconnected"] {
+        let path = root.join(format!("{name}.png"));
+        if std::fs::metadata(&path).ok()?.len() > 65536 {
+            return None;
+        }
+        let bytes = std::fs::read(path).ok()?;
+        // Refuse unexpected dimensions before decoding/allocating.
+        if bytes.get(16..24)? != [0, 0, 0, 16, 0, 0, 0, 16] {
+            return None;
+        }
+        let (width, height, pixels) = horizon_client::hud::decode_bytes(&bytes).ok()?;
+        if width != 16 || height != 16 || pixels.len() != 16 * 16 * 4 {
+            return None;
+        }
+        icons.push(pixels);
+    }
+    icons.try_into().ok()
+}
+fn enabled() -> bool {
+    match std::env::var("HORIZON_NATIVE_VOICE").as_deref() {
+        Ok("1") => true,
+        Ok(_) => false,
+        Err(_) => Game::options_path()
+            .with_file_name("horizon-voice.enabled")
+            .is_file(),
+    }
+}
+fn payload(data: Vec<u8>) -> CustomPayload {
+    CustomPayload {
+        channel: wire::CHANNEL.into(),
+        data,
+    }
+}
+
+impl Game<'_> {
+    pub(super) fn native_voice_joined(&mut self, host: &mut LanHost, conn: u32) {
+        if enabled() {
+            host.hub
+                .send_to(conn, &C::CustomPayload(payload(wire::HELLO.to_vec())));
+        }
+    }
+    pub(super) fn native_voice_server(&mut self, host: &mut LanHost, conn: u32, data: &[u8]) {
+        if !enabled() {
+            return;
+        }
+        self.native_voice
+            .peers
+            .retain(|id, _| host.hub.guest(*id).is_some());
+        let Some(sender) = host.hub.guest(conn).filter(|g| g.placed) else {
+            return;
+        };
+        let sender_id = sender.entity_id as u32;
+        if data == wire::JOIN {
+            self.native_voice.peers.entry(conn).or_default();
+            return;
+        }
+        if !sender.loaded {
+            return;
+        }
+        let Some(budget) = self.native_voice.peers.get_mut(&conn) else {
+            return;
+        };
+        if !budget.accept(data, std::time::Instant::now()) {
+            return;
+        }
+        let Some(data) = wire::forwarded(sender_id, data) else {
+            return;
+        };
+        let packet = C::CustomPayload(payload(data));
+        for &id in self.native_voice.peers.keys().filter(|id| **id != conn) {
+            if host.hub.guest(id).is_some_and(|g| g.loaded) {
+                host.hub.send_to(id, &packet);
+            }
+        }
+    }
+    pub(super) fn native_voice_received(&mut self, data: &[u8]) {
+        if !enabled() {
+            return;
+        }
+        #[cfg(feature = "audio")]
+        {
+            if data == wire::HELLO && self.native_voice.audio.is_none() {
+                match wire::audio::Audio::start() {
+                    Ok(audio) => {
+                        self.native_voice.icons = load_voice_icons();
+                        self.native_voice.audio = Some(audio);
+                        self.send(S::CustomPayload(payload(wire::JOIN.to_vec())));
+                    }
+                    Err(e) => log::warn!("Native voice: {e}"),
+                }
+            } else if let Some(audio) = &self.native_voice.audio {
+                audio.receive(data);
+            }
+        }
+        #[cfg(not(feature = "audio"))]
+        let _ = data;
+    }
+    pub(super) fn native_voice_tick(&mut self) {
+        #[cfg(feature = "audio")]
+        if let Some(audio) = &self.native_voice.audio {
+            if self.remote.is_none() {
+                self.native_voice.audio = None;
+                return;
+            }
+            if self.screen != super::Screen::Playing || !self.focused {
+                audio.mute();
+            }
+            for data in audio.drain() {
+                self.send(S::CustomPayload(payload(data)));
+            }
+        }
+    }
+    pub(super) fn native_voice_toggle(&self) {
+        #[cfg(feature = "audio")]
+        if let Some(audio) = &self.native_voice.audio {
+            audio.toggle();
+        }
+    }
+    pub(super) fn native_voice_hud(&self, batch: &mut horizon_client::hud::HudBatch) {
+        #[cfg(feature = "audio")]
+        if let Some(audio) = &self.native_voice.audio {
+            use horizon_client::hud::rgba;
+            if self.screen != super::Screen::Playing {
+                return;
+            }
+            let failed = audio.error().is_some();
+            let muted = audio.muted();
+            if !failed && !muted && !audio.speaking() {
+                return;
+            }
+            let (x, y) = (8., batch.height - 24.);
+            if let Some(icons) = &self.native_voice.icons {
+                let pixels = &icons[if failed {
+                    2
+                } else if muted {
+                    1
+                } else {
+                    0
+                }];
+                for (i, p) in pixels.as_chunks::<4>().0.iter().enumerate() {
+                    if p[3] != 0 {
+                        batch.fill(
+                            &self.gui.atlas,
+                            x + (i % 16) as f32,
+                            y + (i / 16) as f32,
+                            1.,
+                            1.,
+                            rgba(p[0], p[1], p[2], p[3]),
+                        );
+                    }
+                }
+                return;
+            }
+            let color = if failed {
+                rgba(255, 204, 85, 255)
+            } else if muted {
+                rgba(176, 176, 176, 255)
+            } else {
+                rgba(255, 255, 255, 255)
+            };
+            // Pixel-aligned silhouette and one-pixel shadow, matching the game HUD.
+            for (row, bits) in wire::MIC_PIXELS.iter().enumerate() {
+                for col in 0..16 {
+                    if bits & (1 << (15 - col)) != 0 {
+                        batch.fill(
+                            &self.gui.atlas,
+                            x + col as f32 + 1.,
+                            y + row as f32 + 1.,
+                            1.,
+                            1.,
+                            rgba(0, 0, 0, 160),
+                        );
+                    }
+                }
+            }
+            for (row, bits) in wire::MIC_PIXELS.iter().enumerate() {
+                for col in 0..16 {
+                    if bits & (1 << (15 - col)) != 0 {
+                        batch.fill(
+                            &self.gui.atlas,
+                            x + col as f32,
+                            y + row as f32,
+                            1.,
+                            1.,
+                            color,
+                        );
+                    }
+                }
+            }
+            if failed || muted {
+                for step in 0..12 {
+                    batch.fill(
+                        &self.gui.atlas,
+                        x + 2. + step as f32,
+                        y + 2. + step as f32,
+                        2.,
+                        2.,
+                        rgba(0, 0, 0, 255),
+                    );
+                    batch.fill(
+                        &self.gui.atlas,
+                        x + 2. + step as f32,
+                        y + 1. + step as f32,
+                        1.,
+                        1.,
+                        color,
+                    );
+                }
+            }
+        }
+        #[cfg(not(feature = "audio"))]
+        let _ = batch;
+    }
+}
